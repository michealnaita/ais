# Copy to .env and fill in. .env is gitignored; this file is committed.

# Secret used to sign session and refresh tokens (required).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# First admin account, created at startup when no admin exists.
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_FIRST_NAME=System
DEFAULT_ADMIN_LAST_NAME=Admin

# development | production. SQL statement logging is on only in development.
ENVIRONMENT=development

# Redis used as the Celery broker and result backend.
REDIS_URL=redis://localhost:6379/0

# Optional overrides
# DATABASE_URL=sqlite:///data/app.db
# STORAGE_DIR=storage
# MAX_STORAGE_SIZE=10737418240
